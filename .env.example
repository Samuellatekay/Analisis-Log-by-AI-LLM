# ---- Redis (milik sendiri, db 2) ----
# Format: redis://:PASSWORD@HOST:6379/DB  (password dengan @ : / # harus di-URL-encode). Butuh Redis >= 6.2
REDIS_URL=redis://:ganti-password-redis@192.168.51.39:6379/2
# list = Collector menulis dengan RPUSH ke list ; stream = Redis Streams (XADD)
REDIS_MODE=list
# Daftar list yang dibaca (pisahkan koma). Pastikan tidak dikonsumsi juga oleh Logstash.
REDIS_LISTS=analysis-in,opencti-events,glpi-logs,enrichment-events
# Hanya dipakai mode stream:
REDIS_STREAM=logs:raw
REDIS_GROUP=log-analyzer
# Dead-letter (stream) untuk pesan rusak / gagal kirim
REDIS_DLQ_STREAM=logs:dlq

# ---- PostgreSQL (temp DB) ----
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=ganti-password-postgres
POSTGRES_DB=analyzer
POSTGRES_DSN=postgresql://analyzer:ganti-password-postgres@postgres:5432/analyzer
PG_POOL_MIN=2
PG_POOL_MAX=10
RETENTION_MINUTES=60
RETENTION_INTERVAL_S=60

# ---- Logstash (http input) ----
LOGSTASH_URL=http://logstash:8080
LOGSTASH_USER=analyzer
LOGSTASH_PASSWORD=ganti-password-logstash
LOGSTASH_TIMEOUT_S=5

# ---- DFIR-IRIS ----
IRIS_ENABLED=false
IRIS_URL=https://iris.example.local
IRIS_API_KEY=
# Customer default/fallback untuk alert yang tidak cocok dengan pola routing.
IRIS_CUSTOMER_ID=1
# Routing opsional berdasarkan manager/hostname atau keyword pada event.
# Format: ID:hostname|keyword,ID:hostname|keyword
# Contoh: manager/alert berisi "customer-a" atau "hids-a" -> customer IRIS 1.
IRIS_CUSTOMER_ROUTING_MAP=1:customer-a|hids-a,2:customer-b|hids-b
# v2     = IRIS v3 (UI baru berbasis Svelte; hanya melayani /api/v2). Pakai ini jika ragu.
# legacy = IRIS 2.4.x lama (/alerts/add, /manage/cases/add)
IRIS_API_VERSION=v2
# alert      = hanya buat Alert (analis triase manual)
# alert_case = buat Alert; jika risk >= IRIS_CASE_MIN_RISK otomatis dieskalasi jadi Case
#              (alert dari sumber yang sama dalam IRIS_CASE_WINDOW_S digabung ke case yang sama)
# case       = langsung buat Case (tanpa Alert) untuk risk >= IRIS_MIN_RISK
IRIS_MODE=alert_case
# false = jangan eskalasi Alert ke Case secara otomatis; alert tetap dibuat untuk eskalasi manual di IRIS.
IRIS_AUTO_ESCALATE=true
IRIS_CASE_MIN_RISK=75
# Hanya alert Wazuh dengan level >= nilai ini yang dikirim ke IRIS (0 = nonaktif).
# Event non-Wazuh (tanpa event.wazuh_level) tidak terpengaruh.
IRIS_MIN_WAZUH_LEVEL=12
# Batas atas level (0 = tanpa batas). Isi 12 HANYA jika level 13-15 juga tidak boleh masuk.
IRIS_MAX_WAZUH_LEVEL=0
# Opsional: IP manager Wazuh jika event tidak mengirimkannya (Wazuh standar umumnya hanya mengirim manager.name).
WAZUH_MANAGER_IP=
IRIS_CASE_WINDOW_S=3600
# Alert dibuat jika risk score >= nilai ini (verdict false_positive/benign tidak dikirim)
IRIS_MIN_RISK=60
# 1 alert per (source, action) dalam jendela ini, mencegah banjir alert saat burst
# 300 detik = 5 menit. Kosong = nonaktif. Jika IRIS_MODE=case, dedup window tidak berlaku.
IRIS_DEDUP_WINDOW_S=300
IRIS_WORKERS=1
IRIS_QUEUE_MAX=500
IRIS_TIMEOUT_S=30
# Verifikasi TLS. Untuk sertifikat self-signed gunakan IRIS_CA_CERT (jangan matikan verify).
IRIS_VERIFY_SSL=true
IRIS_CA_CERT=
# ID severity berbeda antar instalasi IRIS. Periksa dengan:
# docker compose run --rm app python check_connections.py --iris-ids
# Kosong = auto-discovery; map yang diisi akan menimpa auto-discovery.
IRIS_SEVERITY_MAP=
# IRIS v3 MEWAJIBKAN alert_status_id. Kosong = dicari otomatis (status 'New'). Lihat ID: check_connections.py --iris-ids
IRIS_STATUS_ID=
# Link balik ke Kibana, contoh: https://kibana.local/app/discover#/?_a=(query:(language:kuery,query:'log_uuid:"{log_uuid}"'))
IRIS_SOURCE_LINK_TEMPLATE=
# IRIS_STREAM_HTTP_PORT=17771 port untuk endpoint HTTP
IRIS_STREAM_PORT=17771
IRIS_POLL_INTERVAL=5
IRIS_REQUEST_TIMEOUT=30
IRIS_STREAM_BIND=0.0.0.0
IRIS_ALERT_PAGE_SIZE=100
IRIS_ALERT_WORKERS=4
IRIS_ALERT_MAX_ATTEMPTS=8
IRIS_ALERT_RETRY_BASE_SECONDS=2
IRIS_ALERT_CLAIM_IDLE_MS=900000
IRIS_ALERT_SEEN_TTL_SECONDS=7776000
# Opsional, default memakai REDIS_URL. Redis Streams menyimpan antrean pengiriman alert.
IRIS_STREAM_REDIS_URL=
IRIS_ALERT_QUEUE_STREAM=iris:alerts:outbound
IRIS_ALERT_QUEUE_GROUP=iris-stream
# ===== Tampilan DFIR-IRIS =====
# Tipe aset untuk Source/Destination (1 = Account)
IRIS_ASSET_TYPE_ID=1

# Tipe IOC dan TLP terdeteksi otomatis dari IRIS. Isi dengan ID numerik hanya jika
# log menampilkan "tipe IOC tidak ditemukan otomatis". Biarkan kosong jika otomatis.
IRIS_IOC_TYPE_MAP=
IRIS_IOC_TLP_ID=2

# false = bagian itu tidak ditulis di teks Description alert/case
# (Source/Destination ada di tab Assets, IOC/TI/Geolokasi di tab IOCs)
IRIS_SHOW_EVENT=false
IRIS_ASSETS_IN_DESCRIPTION=false
IRIS_IOCS_IN_DESCRIPTION=false
# false = Description case sama ringkas dengan alert
IRIS_CASE_FULL_DESCRIPTION=false

# ===== Update case =====
IRIS_CASE_UPDATE=true

# URL stream yang mau diambil datanya (sesuaikan dengan IP/Nama service sumber).
# incident_report disimpan utuh; aplikasi tidak membatasi panjang tetap laporan AI.
TARGET_STREAM_URL=http://vm-receiver:17772/stream
# Periksa relasi Alert–Case untuk menyalin Description setelah eskalasi di UI IRIS.
IRIS_CASE_SUMMARY_SYNC_INTERVAL_S=30

# soc-risk-engine
RISK_ENGINE_URL=http://192.168.51.39:8000
RISK_STRATEGY=ahp_2026


# ---- Tuning burst ----
CONSUMER_WORKERS=2
BATCH_SIZE=200
BLOCK_MS=1000
RECLAIM_IDLE_MS=30000
REPEAT_WINDOW_S=300
SHUTDOWN_GRACE_S=20

# ---- Risk ----
RISK_ENGINE_MAX_CONCURRENCY=16
RISK_NORMALIZE=false
LOG_LEVEL=INFO
