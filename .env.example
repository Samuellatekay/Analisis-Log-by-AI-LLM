# ---- Redis (milik sendiri, db 2) ----
# Format: redis://:PASSWORD@HOST:6379/DB  (password dengan @ : / # harus di-URL-encode). Butuh Redis >= 6.2
REDIS_URL=redis://:ganti-password-redis@192.168.51.39:6379/2
# list = Collector menulis dengan RPUSH ke list ; stream = Redis Streams (XADD)
REDIS_MODE=list
# Daftar list yang dibaca (pisahkan koma). JANGAN list yang masih di-BLPOP Logstash (lihat README)
REDIS_LISTS=analysis-in
# Hanya dipakai mode stream:
REDIS_STREAM=logs:raw
REDIS_GROUP=log-analyzer
# Dead-letter (stream) untuk pesan rusak / gagal kirim
REDIS_DLQ_STREAM=logs:dlq

# ---- PostgreSQL (temp DB) ----
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=ganti-password-postgres
POSTGRES_DB=analyzer
POSTGRES_DSN=postgresql://analyzer:ganti-password-postgres@postgres:5432/analyzer
PG_POOL_MIN=2
PG_POOL_MAX=10
RETENTION_MINUTES=60
RETENTION_INTERVAL_S=60

# ---- Logstash (http input) ----
LOGSTASH_URL=http://logstash:8080
LOGSTASH_USER=analyzer
LOGSTASH_PASSWORD=ganti-password-logstash
LOGSTASH_TIMEOUT_S=5

# ---- LLM Providers ----
# Urutan prioritas + fallback otomatis. Pilihan: ollama, gemini, openai, anthropic
# Contoh: "ollama,gemini" = lokal dulu, jika gagal/timeout pakai Gemini.
LLM_PROVIDERS=ollama
# Redact password/token/email/API key sebelum dikirim ke provider cloud
LLM_MASK_SENSITIVE=true
LLM_CLOUD_TIMEOUT_S=90
PERSONA_PATH=soc_persona.md

# Ollama (lokal)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=600

# OpenAI / ChatGPT (isi nama model terbaru sesuai akun Anda)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- DFIR-IRIS ----
IRIS_ENABLED=false
IRIS_URL=https://iris.example.local
IRIS_API_KEY=
IRIS_CUSTOMER_ID=1
# Alert dibuat jika risk score >= nilai ini (verdict false_positive/benign tidak dikirim)
IRIS_MIN_RISK=60
# 1 alert per (source, action) dalam jendela ini, mencegah banjir alert saat burst
IRIS_DEDUP_WINDOW_S=300
IRIS_WORKERS=1
IRIS_QUEUE_MAX=500
IRIS_TIMEOUT_S=10
# Verifikasi TLS. Untuk sertifikat self-signed gunakan IRIS_CA_CERT (jangan matikan verify).
IRIS_VERIFY_SSL=true
IRIS_CA_CERT=
# Cocokkan dengan ID severity di IRIS (Advanced > Severities)
IRIS_SEVERITY_MAP=low:3,medium:4,high:5,critical:6
IRIS_STATUS_ID=
# Link balik ke Kibana, contoh: https://kibana.local/app/discover#/?_a=(query:(language:kuery,query:'log_uuid:"{log_uuid}"'))
IRIS_SOURCE_LINK_TEMPLATE=

# ---- Tuning burst ----
CONSUMER_WORKERS=2
BATCH_SIZE=200
BLOCK_MS=1000
RECLAIM_IDLE_MS=30000
REPEAT_WINDOW_S=300
AI_WORKERS=2
AI_QUEUE_MAX=1000
AI_MIN_RISK=40
SHUTDOWN_GRACE_S=20

# ---- Risk ----
RISK_NORMALIZE=false
LOG_LEVEL=INFO
